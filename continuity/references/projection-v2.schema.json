{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:continuity:schema:projection-v2",
  "title": "Continuity v2 deterministic projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectionVersion", "generatedFrom", "projectedAt", "project", "finalGoalId", "goals", "criteria", "tasks", "attempts", "claims", "evidence", "failures", "feedback", "handoffs", "lessons", "decisions", "contradictions", "legacyImports", "sourceRefs", "workspaceAtLastEvent"],
  "properties": {
    "schemaVersion": { "const": 2 }, "projectionVersion": { "const": 1 },
    "generatedFrom": { "type": "object", "additionalProperties": false, "required": ["epochId", "sequence", "eventHash"], "properties": { "epochId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "sequence": { "type": "integer", "minimum": 1 }, "eventHash": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Sha256" } } },
    "projectedAt": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Timestamp" },
    "project": { "$ref": "urn:continuity:schema:v2-contract#/$defs/ProjectDef" },
    "finalGoalId": { "anyOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, { "type": "null" }] },
    "goals": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/GoalState" } },
    "criteria": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/CriterionState" } },
    "tasks": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/TaskState" } },
    "attempts": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/AttemptState" } },
    "claims": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/ClaimState" } },
    "evidence": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/EvidenceState" } },
    "failures": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/FailureState" } },
    "feedback": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/FeedbackState" } },
    "handoffs": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/HandoffState" } },
    "lessons": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/LessonState" } },
    "decisions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/DecisionState" } },
    "contradictions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/ContradictionState" } },
    "legacyImports": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/LegacyImport" } },
    "sourceRefs": { "type": "array", "maxItems": 50, "items": { "$ref": "urn:continuity:schema:v2-contract#/$defs/SourceRef" } },
    "workspaceAtLastEvent": { "$ref": "urn:continuity:schema:v2-contract#/$defs/WorkspaceObservation" }
  },
  "$defs": {
    "DerivedIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" } },
    "GoalState": { "type": "object", "additionalProperties": false, "required": ["goalId", "title", "outcome", "isFinal", "authority", "basis", "criterionIds", "lifecycle", "acceptance", "failureIds", "derivedFromEventIds"], "properties": { "goalId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "title": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "outcome": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "isFinal": { "type": "boolean" }, "parentGoalId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "authority": { "enum": ["user", "repository", "tool", "coordinator", "subagent", "migration"] }, "basis": { "enum": ["user_stated", "source_observed", "tool_observed", "agent_reported", "agent_inferred", "legacy_unverified"] }, "criterionIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "lifecycle": { "enum": ["active", "achieved", "blocked", "abandoned", "retired"] }, "acceptance": { "enum": ["pending", "accepted", "rejected", "not_requested"] }, "failureIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "nextAction": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
    "CriterionState": { "type": "object", "additionalProperties": false, "required": ["criterionId", "ownerType", "ownerId", "condition", "scope", "requiredEvidenceKinds", "freshnessPolicy", "waivableByUser", "lifecycle", "verification", "evidenceRefs", "derivedFromEventIds"], "properties": { "criterionId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "ownerType": { "enum": ["goal", "task"] }, "ownerId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "condition": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "scope": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "requiredEvidenceKinds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "enum": ["git_blob", "file", "command", "test", "browser_render", "url", "user_message", "agent_report", "graphify_receipt"] } }, "freshnessPolicy": { "$ref": "urn:continuity:schema:v2-contract#/$defs/FreshnessPolicy" }, "waivableByUser": { "type": "boolean" }, "lifecycle": { "enum": ["active", "waived_by_user", "retired"] }, "verification": { "enum": ["not_run", "passed", "failed", "inconclusive", "not_applicable"] }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
    "TaskState": { "type": "object", "additionalProperties": false, "required": ["taskId", "goalId", "title", "scope", "pathOwnership", "owner", "dependencyIds", "criterionIds", "userFacing", "requiredForGoal", "execution", "verification", "acceptance", "attemptIds", "failureIds", "feedbackIds", "evidenceRefs", "derivedFromEventIds"], "properties": { "taskId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "goalId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "title": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "scope": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "pathOwnership": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Path" } }, "owner": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "dependencyIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "criterionIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "userFacing": { "type": "boolean" }, "requiredForGoal": { "type": "boolean" }, "execution": { "enum": ["planned", "in_progress", "implemented", "blocked", "failed", "completed", "abandoned"] }, "verification": { "enum": ["not_run", "passed", "failed", "inconclusive", "not_applicable"] }, "acceptance": { "enum": ["pending", "accepted", "rejected", "not_requested"] }, "currentAttemptId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "attemptIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "failureIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "feedbackIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "nextAction": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } }, "allOf": [{ "if": { "anyOf": [{ "properties": { "userFacing": { "const": true } }, "required": ["userFacing"] }, { "properties": { "requiredForGoal": { "const": true } }, "required": ["requiredForGoal"] }] }, "then": { "properties": { "criterionIds": { "minItems": 1 } } } }] },
    "AttemptState": { "type": "object", "additionalProperties": false, "required": ["attemptId", "taskId", "ordinal", "owner", "approachId", "hypothesisId", "approachSummary", "outcome", "startedAt", "evidenceRefs", "derivedFromEventIds"], "properties": { "attemptId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "taskId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 10000 }, "owner": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "approachId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "hypothesisId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "approachSummary": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "changeSummary": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "retryJustification": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "respondsToFailureId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "respondsToFeedbackId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "outcome": { "enum": ["in_progress", "succeeded", "failed", "blocked", "inconclusive", "abandoned"] }, "startedAt": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Timestamp" }, "endedAt": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Timestamp" }, "summary": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "failureId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } }, "allOf": [{ "if": { "properties": { "outcome": { "enum": ["failed", "blocked", "inconclusive"] } }, "required": ["outcome"] }, "then": { "required": ["failureId"] }, "else": { "not": { "required": ["failureId"] } } }] },
    "ClaimState": { "type": "object", "additionalProperties": false, "required": ["claimId", "subject", "predicate", "scopeKey", "cardinality", "value", "basis", "authority", "lifecycle", "claimKey", "evidenceRefs", "derivedFromEventIds"], "properties": { "claimId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "subject": { "$ref": "urn:continuity:schema:v2-contract#/$defs/SubjectRef" }, "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_-]*)+$", "maxLength": 160 }, "scopeKey": { "allOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, { "maxLength": 240 }] }, "cardinality": { "enum": ["one", "many"] }, "value": { "$ref": "urn:continuity:schema:v2-contract#/$defs/JcsValue" }, "valueKey": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "basis": { "enum": ["user_stated", "source_observed", "tool_observed", "agent_reported", "agent_inferred", "legacy_unverified"] }, "authority": { "enum": ["user", "repository", "tool", "coordinator", "subagent", "migration"] }, "lifecycle": { "enum": ["active", "superseded", "retracted", "contested"] }, "claimKey": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Sha256" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "contradictionId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
    "EvidenceState": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "kind", "subjectId", "scope", "locator", "observedAt", "verifier", "method", "outcome", "policy", "sourceRefs", "sensitivity", "derivedFromEventIds"], "properties": { "evidenceId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "kind": { "enum": ["git_blob", "file", "command", "test", "browser_render", "url", "user_message", "agent_report", "graphify_receipt"] }, "subjectId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "scope": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "locator": { "allOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, { "maxLength": 500 }] }, "sourceVersion": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "contentDigest": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Sha256" }, "observedAt": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Timestamp" }, "verifier": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "enum": ["user", "coordinator", "subagent", "tool", "migration"] }, "id": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "version": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" } } }, "method": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "outcome": { "enum": ["passed", "failed", "inconclusive", "observed"] }, "policy": { "$ref": "urn:continuity:schema:v2-contract#/$defs/FreshnessPolicy" }, "sourceRefs": { "type": "array", "maxItems": 50, "items": { "$ref": "urn:continuity:schema:v2-contract#/$defs/SourceRef" } }, "workspaceAtObservation": { "$ref": "urn:continuity:schema:v2-contract#/$defs/WorkspaceObservation" }, "sensitivity": { "enum": ["public", "internal", "restricted"] }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
    "FailureState": { "type": "object", "additionalProperties": false, "required": ["failureId", "subject", "terminal", "approachId", "hypothesisId", "symptomClass", "observedSymptom", "impact", "unchanged", "rootCause", "evidenceRefs", "retryCount", "derivedFromEventIds"], "properties": { "failureId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "subject": { "allOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/SubjectRef" }, { "properties": { "type": { "enum": ["goal", "task"] } } }] }, "attemptId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "owner": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "responsibleBoundary": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "terminal": { "enum": ["failed", "blocked", "abandoned", "inconclusive"] }, "approachId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "hypothesisId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "symptomClass": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "observedSymptom": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "impact": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "unchanged": { "allOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/TextArray" }, { "minItems": 1 }] }, "rootCause": { "type": "object", "additionalProperties": false, "required": ["state", "summary"], "properties": { "state": { "enum": ["confirmed", "hypothesis", "unknown"] }, "summary": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" } } }, "evidenceRefs": { "allOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, { "minItems": 1 }] }, "retryCount": { "type": "integer", "minimum": 0 }, "lessonId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "nextAction": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "resolvedByAttemptId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "resolvedByEventId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } }, "allOf": [{ "if": { "properties": { "subject": { "properties": { "type": { "const": "task" } }, "required": ["type"] } } }, "then": { "required": ["attemptId", "owner"] } }, { "if": { "properties": { "subject": { "properties": { "type": { "const": "goal" } }, "required": ["type"] } } }, "then": { "anyOf": [{ "required": ["owner"] }, { "required": ["responsibleBoundary"] }], "not": { "required": ["attemptId"] } } }, { "anyOf": [{ "required": ["lessonId"] }, { "required": ["nextAction"] }] }] },
    "FeedbackState": {
      "type": "object", "additionalProperties": false,
      "required": ["feedbackId", "subjectId", "disposition", "acceptanceEffect", "statement", "evidenceRef", "lifecycle", "derivedFromEventIds"],
      "properties": { "feedbackId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "subjectId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "disposition": { "enum": ["satisfied", "dissatisfied", "rejected"] }, "acceptanceEffect": { "enum": ["accept", "reject", "keep_pending"] }, "statement": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "evidenceRef": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "baselineApproachId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "baselineHypothesisId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "lessonId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "nextAction": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "correctionPlan": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "supersedesFeedbackId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "lifecycle": { "enum": ["active", "superseded"] }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } },
      "allOf": [
        { "if": { "properties": { "disposition": { "const": "satisfied" } }, "required": ["disposition"] }, "then": { "properties": { "acceptanceEffect": { "const": "accept" } } } },
        { "if": { "properties": { "disposition": { "const": "rejected" } }, "required": ["disposition"] }, "then": { "required": ["baselineApproachId", "baselineHypothesisId"], "properties": { "acceptanceEffect": { "const": "reject" } }, "anyOf": [{ "required": ["lessonId"] }, { "required": ["nextAction"] }, { "required": ["correctionPlan"] }] } },
        { "if": { "properties": { "disposition": { "const": "dissatisfied" } }, "required": ["disposition"] }, "then": { "required": ["baselineApproachId", "baselineHypothesisId"], "properties": { "acceptanceEffect": { "enum": ["keep_pending", "reject"] } }, "anyOf": [{ "required": ["lessonId"] }, { "required": ["nextAction"] }, { "required": ["correctionPlan"] }] } }
      ]
    },
    "HandoffState": {
      "type": "object", "additionalProperties": false,
      "required": ["handoffId", "taskId", "assignmentId", "parentRunId", "owner", "scope", "pathOwnership", "criterionIds", "deliverables", "prohibitedActions", "state", "evidenceRefs", "derivedFromEventIds"],
      "properties": { "handoffId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "taskId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "assignmentId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "parentRunId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "owner": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "scope": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "pathOwnership": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Path" } }, "criterionIds": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "deliverables": { "$ref": "urn:continuity:schema:v2-contract#/$defs/TextArray" }, "prohibitedActions": { "$ref": "urn:continuity:schema:v2-contract#/$defs/TextArray" }, "state": { "enum": ["assigned", "reported", "accepted", "rejected", "cancelled"] }, "report": { "$ref": "urn:continuity:schema:v2-contract#/$defs/HandoffReport" }, "decisionReason": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } },
      "allOf": [
        { "if": { "properties": { "state": { "const": "assigned" } }, "required": ["state"] }, "then": { "properties": { "evidenceRefs": { "maxItems": 0 } }, "not": { "anyOf": [{ "required": ["report"] }, { "required": ["decisionReason"] }] } } },
        { "if": { "properties": { "state": { "const": "reported" } }, "required": ["state"] }, "then": { "required": ["report"], "properties": { "evidenceRefs": { "maxItems": 0 } }, "not": { "required": ["decisionReason"] } } },
        { "if": { "properties": { "state": { "enum": ["accepted", "rejected"] } }, "required": ["state"] }, "then": { "required": ["report", "decisionReason"], "properties": { "evidenceRefs": { "minItems": 1 } } } },
        { "if": { "properties": { "state": { "const": "cancelled" } }, "required": ["state"] }, "then": { "required": ["decisionReason"], "properties": { "evidenceRefs": { "minItems": 1 } } } }
      ]
    },
    "LessonState": { "type": "object", "additionalProperties": false, "required": ["lessonId", "summary", "evidenceRefs", "derivedFromEventIds"], "properties": { "lessonId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "taskId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "failureId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "summary": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "nextDifferentAction": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
    "DecisionState": { "type": "object", "additionalProperties": false, "required": ["decisionId", "subjectId", "choice", "rationale", "evidenceRefs", "derivedFromEventIds"], "properties": { "decisionId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "subjectId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "choice": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "rationale": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
    "ContradictionState": { "type": "object", "additionalProperties": false, "required": ["contradictionId", "claimKey", "claimIds", "state", "derivedFromEventIds"], "properties": { "contradictionId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "claimKey": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Sha256" }, "claimIds": { "allOf": [{ "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, { "minItems": 2 }] }, "state": { "enum": ["contested", "resolved"] }, "reason": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Text" }, "evidenceRefs": { "$ref": "urn:continuity:schema:v2-contract#/$defs/IdArray" }, "resolvedByEventId": { "$ref": "urn:continuity:schema:v2-contract#/$defs/Id" }, "derivedFromEventIds": { "$ref": "#/$defs/DerivedIds" } } },
